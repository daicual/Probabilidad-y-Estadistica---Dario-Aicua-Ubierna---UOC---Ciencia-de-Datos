install.packages('markdown')
install.packages('rmarkdown')
# Datos
x <- c(0,1,1,3,0,4,3,2)
# Media
media <- mean(x)
# Varianza (poblacional y muestral)
var_muestral <- var(x)          # divide entre (n-1)
var_poblacional <- mean((x - mean(x))^2)  # divide entre n
# Desviación típica
desv_muestral <- sd(x)          # usa varianza muestral
desv_poblacional <- sqrt(var_poblacional)
# Mediana
mediana <- median(x)
# Resultados
media
var_muestral
var_poblacional
desv_muestral
desv_poblacional
mediana
x <- c(0,1,1,3,0,4,3,2)
media <- mean(x)
varianza <- mean((x - media)^2)
desviacion <- sqrt(varianza)
mediana <- median(x)
media
varianza
desviacion
mediana
# Datos
x <- c(0,1,1,3,0,4,3,2)
# Cálculos poblacionales con 3 decimales
media <- round(mean(x), 3)
varianza <- round(mean((x - mean(x))^2), 3)
desviacion <- round(sqrt(varianza), 3)
mediana <- round(median(x), 3)
# Mostrar resultados
media
varianza
desviacion
mediana
